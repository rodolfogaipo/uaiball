{
  "rules": {
    "uaiball": {
      "scores": {
        ".read": true,
        "$mesa": {
          ".indexOn": ["score"],
          "$id": {
            ".write": "!data.exists()",
            ".validate": "$mesa.matches(/^[a-z0-9]{2,20}$/) && newData.hasChildren(['name','score','diff','date']) && newData.child('name').isString() && newData.child('name').val().length <= 12 && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() < 100000000"
          }
        }
      }
    }
  }
}
